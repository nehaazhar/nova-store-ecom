{
	"name": "nova-store",
	"version": "1.0.0",
	"description": "MERN ecommerce shop",
	"main": "backend/server.js",
	"scripts": {
		"dev": "nodemon backend/server.js",
		"start": "node backend/server.js",
		"seed:products": "node backend/scripts/seedProducts.js",
		"seed:products:clear": "node backend/scripts/seedProducts.js --clear",
		"seed:products:api": "node backend/scripts/seedProductsFromApi.js --clear",
		"test": "node --test backend/tests",
		"build": "npm install && npm install --prefix frontend --include=dev && npm run build --prefix frontend"
	},
	"keywords": [],
	"author": "",
	"type": "module",
	"license": "ISC",
	"engines": {
		"node": "20.x"
	},
	"dependencies": {
		"bcryptjs": "^2.4.3",
		"cloudinary": "^2.4.0",
		"cookie-parser": "^1.4.6",
		"cors": "^2.8.5",
		"dotenv": "^16.4.5",
		"express": "^4.19.2",
		"express-rate-limit": "^8.6.2",
		"helmet": "^8.3.0",
		"ioredis": "^5.4.1",
		"jsonwebtoken": "^9.0.2",
		"mongoose": "^8.5.3",
		"nodemailer": "^9.0.5",
		"stripe": "^16.8.0"
	},
	"devDependencies": {
		"nodemon": "^3.1.4"
	}
}
